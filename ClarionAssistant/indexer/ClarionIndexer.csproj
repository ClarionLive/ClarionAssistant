<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    clarion-indexer — standalone console tool that builds/queries the CodeGraph SQLite DB
    consumed by the bundled LSP server (CodeGraphBridge).

    SINGLE SHARED SOURCE (ticket d1a0aea6; supersedes the vendored copy from GitHub #30).
    The Graph/Parsing layer is <Compile Include>'d from ..\CodeGraph\ — the SAME files the
    addin compiles — so the two builds cannot drift. The original reason for vendoring
    (the link target lived in a different, un-published repo) no longer applies: everything
    linked here is inside THIS repo, so a clean checkout still builds self-contained.

    The vendored copies under this project's Graph\ and Parsing\ folders are GONE — do not
    recreate them; edits go in ..\CodeGraph\ (and ..\Services\ for the three helpers below)
    and serve both projects. History for the drift this caused: three of six shared files
    had silently diverged by 2026-08-10.

    The linked Services files (RedFileService, ClarionVersionService, EncodingHelper) are
    IDE-FREE — pure System.*; ClarionVersionService touches ICSharpCode.Core only via
    reflection in a try/catch, so it compiles and runs (returning null) without the IDE.
    Anything IDE-coupled must stay out of the shared layer.
  -->
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProjectGuid>{B2C3D4E5-F6A7-8901-BCDE-F12345678901}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClarionIndexer</RootNamespace>
    <AssemblyName>clarion-indexer</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <RuntimeIdentifiers>win-x86</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- SQLite (FTS5): use the vendored DLLs the main addin ships in ..\lib\sqlite-fts5,
       instead of the unpublished stub.system.data.sqlite.core.netframework NuGet package
       (not restorable on a clean checkout). Keeps the indexer self-contained per #30. -->
  <PropertyGroup>
    <SqliteVendored>$(MSBuildProjectDirectory)\..\lib\sqlite-fts5</SqliteVendored>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Data.SQLite">
      <HintPath>$(SqliteVendored)\System.Data.SQLite.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Entry point (owned by this project) -->
    <Compile Include="Program.cs" />
    <!-- Graph layer — SHARED with the addin, linked from ..\CodeGraph\ (one copy on disk) -->
    <Compile Include="..\CodeGraph\Graph\CodeGraphDatabase.cs"><Link>Graph\CodeGraphDatabase.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Graph\CodeGraphIndexer.cs"><Link>Graph\CodeGraphIndexer.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Graph\IndexProgress.cs"><Link>Graph\IndexProgress.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Graph\CodeGraphQuery.cs"><Link>Graph\CodeGraphQuery.cs</Link></Compile>
    <!-- Parsing layer — SHARED, linked from ..\CodeGraph\ -->
    <Compile Include="..\CodeGraph\Parsing\ClarionParser.cs"><Link>Parsing\ClarionParser.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Parsing\ClarionBuiltins.cs"><Link>Parsing\ClarionBuiltins.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Parsing\SolutionParser.cs"><Link>Parsing\SolutionParser.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Parsing\ProjectParser.cs"><Link>Parsing\ProjectParser.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Parsing\SourceResolver.cs"><Link>Parsing\SourceResolver.cs</Link></Compile>
    <!-- Models — SHARED, linked from ..\CodeGraph\ -->
    <Compile Include="..\CodeGraph\Parsing\Models\ClarionSymbol.cs"><Link>Parsing\Models\ClarionSymbol.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Parsing\Models\ClarionRelationship.cs"><Link>Parsing\Models\ClarionRelationship.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Parsing\Models\SolutionProject.cs"><Link>Parsing\Models\SolutionProject.cs</Link></Compile>
    <Compile Include="..\CodeGraph\Parsing\Models\ParseResult.cs"><Link>Parsing\Models\ParseResult.cs</Link></Compile>
    <!-- IDE-free Services the shared layer needs (see header comment) -->
    <Compile Include="..\Services\RedFileService.cs"><Link>Services\RedFileService.cs</Link></Compile>
    <Compile Include="..\Services\ClarionConfigDirectory.cs"><Link>Services\ClarionConfigDirectory.cs</Link></Compile>
    <Compile Include="..\Services\ClarionVersionService.cs"><Link>Services\ClarionVersionService.cs</Link></Compile>
    <Compile Include="..\Services\EncodingHelper.cs"><Link>Services\EncodingHelper.cs</Link></Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Copy x86 SQLite.Interop.dll to output directory after build -->
  <Target Name="CopySQLiteInterop" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)x86" />
    <Copy SourceFiles="$(SqliteVendored)\SQLite.Interop.dll" DestinationFolder="$(OutputPath)x86" SkipUnchangedFiles="true" />
  </Target>
</Project>
