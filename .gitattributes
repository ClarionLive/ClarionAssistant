# Vendored third-party license texts are reproduced VERBATIM from upstream.
# core.autocrlf is true on this repo, which would rewrite their line endings on
# checkout. These are legal documents we redistribute on someone else's behalf --
# keep them byte-identical to what was published.
third-party/** -text
# Same for a bundled skill's own licence (session-viewer, MIT, by Dinko Bacun).
marketplace/plugins/clarion-assistant/skills/session-viewer/LICENSE -text
# Batch files must be CRLF in every checkout, whatever core.autocrlf says: cmd.exe
# can mis-resolve goto/call labels in an LF-only file, and the plugin launcher
# (clarion-tools.cmd) is label-driven.
*.cmd text eol=crlf
*.bat text eol=crlf
